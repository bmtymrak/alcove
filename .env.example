# Use the HTTPS proxy's hostname, without scheme or port.
ALCOVE_ALLOWED_HOSTS=notes.example.net
# Set a private value, for example from openssl rand -hex 48.
ALCOVE_SECRET_KEY=
# Enable only when the trusted HTTPS proxy replaces X-Forwarded-Proto.
ALCOVE_TRUST_PROXY_HTTPS=1
ALCOVE_PORT=8000
# Pre-create this directory on local disk, owned by the container UID/GID.
ALCOVE_DATA_DIR=/srv/alcove/data
ALCOVE_UID=10001
ALCOVE_GID=10001
